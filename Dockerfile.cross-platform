FROM node:22-slim

# Debian Chromium is available for both amd64 (Windows/Linux hosts) and arm64
# (Apple Silicon), unlike the amd64-only Google Chrome repository.
RUN apt-get update \
    && apt-get install -y \
      chromium \
      fonts-ipafont-gothic \
      fonts-wqy-zenhei \
      fonts-thai-tlwg \
      fonts-kacst \
      fonts-freefont-ttf \
      libxss1 \
      --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY prisma ./prisma
COPY prisma.config.ts ./
RUN npx prisma generate

COPY . .
COPY docker-entrypoint.cross-platform.sh /usr/local/bin/aerocompliance-entrypoint
RUN chmod +x /usr/local/bin/aerocompliance-entrypoint

EXPOSE 3000

CMD ["/usr/local/bin/aerocompliance-entrypoint"]
